# MCP Access Control Rules
#
# Controls which MCP tool calls are allowed, denied, or restricted.
# The MCP proxy intercepts JSON-RPC tool calls and enforces these rules
# before forwarding to the upstream Atlassian MCP server.
#
# Place your config as one of (in priority order):
#   .mcp-access-rules.yaml         (project-local, gitignored)
#   mcp-access-rules.local.yaml    (project-local, gitignored)
#   mcp-access-rules.yaml          (project default, committed)
#   ~/.config/claude-podman/mcp-access-rules.yaml  (user global)

# Upstream Atlassian MCP server URL
upstream: https://mcp.atlassian.com/v1/mcp

# Tools that always pass through (reads). Supports glob wildcards (* matches any characters).
allow:
  - confluence_search
  - confluence_get_*
  - confluence_get_page_children
  - confluence_get_comments
  - jira_get_*
  - jira_search
  - jira_list_*

# Tools that are always blocked (overrides allow)
deny:
  - confluence_delete_page

# Write tools with resource-level restrictions.
# Each entry specifies:
#   field:   which argument field to check
#   allowed: list of permitted values (supports PREFIX-* wildcards)
restrict:
  confluence_update_page:
    field: pageId
    allowed: ["1095041067", "379191456"]
  confluence_create_page:
    field: spaceKey
    allowed: ["TEAM", "DOCS"]
  jira_update_issue:
    field: issueKey
    allowed: ["PROJ-*"]
  jira_create_issue:
    field: projectKey
    allowed: ["PROJ"]
  jira_add_comment:
    field: issueKey
    allowed: ["PROJ-*"]
  jira_transition_issue:
    field: issueKey
    allowed: ["PROJ-*"]

# Default policy for tools not matching any list above: "deny" or "allow"
# "deny" = block unknown tools (recommended for security)
# "allow" = permit unknown tools (use only if you trust all MCP tools)
default: deny
